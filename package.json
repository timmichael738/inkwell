{
  "name": "inkwell",
  "private": true,
  "version": "1.0.0",
  "description": "Real-time collaborative Markdown editor: Yjs CRDTs over WebSockets, live cursors, SQLite persistence and version history.",
  "type": "module",
  "license": "MIT",
  "author": "Michael Timothy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmichael738/inkwell.git"
  },
  "keywords": [
    "collaborative-editing",
    "crdt",
    "yjs",
    "websocket",
    "codemirror",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/main.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/src/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.18",
    "fastify": "^5.12.8",
    "lib0": "^0.2.120",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "ws": "^8.23.0"
  }
}
